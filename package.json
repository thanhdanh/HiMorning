{
  "name": "himorning",
  "private": true,
  "type": "module",
  "workspaces": [
    "functions"
  ],
  "scripts": {
    "test": "vitest run --exclude tests/firestore.test.ts",
    "test:coverage": "firebase emulators:exec --project demo-himorning --only firestore \"vitest run --coverage\"",
    "test:emulator": "firebase emulators:exec --project demo-himorning --only firestore \"vitest run tests/firestore.test.ts\"",
    "build": "npm run build --workspace functions",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "metrics:ai": "node scripts/collect-ai-usage.mjs"
  },
  "devDependencies": {
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "@types/node": "^22",
    "firebase-tools": "15.33.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0"
  }
}
