{
  "name": "himorning",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --exclude tests/firestore.test.ts",
    "test:coverage": "firebase emulators:exec --project demo-himorning --only firestore \"vitest run --coverage\"",
    "test:emulator": "firebase emulators:exec --project demo-himorning --only firestore \"vitest run tests/firestore.test.ts\"",
    "build": "pnpm --filter @himorning/functions run build",
    "typecheck": "tsc --noEmit && pnpm --filter @himorning/worker run typecheck",
    "check": "pnpm run typecheck && pnpm test && pnpm run build",
    "metrics:ai": "node scripts/collect-ai-usage.mjs",
    "contracts:generate": "pnpm run build && node scripts/export-contracts.mjs",
    "prepare:firebase": "pnpm run build && node scripts/prepare-firebase.mjs",
    "test:inference": "backend/inference/.venv/bin/python -m unittest discover -s backend/inference -p \"test_*.py\" -v",
    "deploy:staging": "pnpm run build && node scripts/deploy-staging.mjs",
    "build:worker": "pnpm --filter @himorning/worker run build",
    "deploy:free": "pnpm run typecheck && pnpm --filter @himorning/worker run deploy"
  },
  "devDependencies": {
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "typescript": "7.0.2",
    "@types/node": "^22",
    "firebase-tools": "15.33.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "packageManager": "pnpm@10.34.6"
}
