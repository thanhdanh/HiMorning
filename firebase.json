{
  "functions": [
    {
      "source": "functions",
      "codebase": "himorning",
      "runtime": "nodejs22",
      "predeploy": [
        "npm run build --workspace functions"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
