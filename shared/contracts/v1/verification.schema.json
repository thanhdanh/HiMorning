{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:himorning:verification:v1",
  "title": "HiMorning verification callable payloads",
  "$defs": {
    "CreateRequest": {
      "type": "object",
      "properties": {
        "requestID": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "challenge": {
          "type": "string",
          "const": "pushup"
        },
        "target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "consentVersion": {
          "type": "string",
          "const": "2026-10-11"
        }
      },
      "required": [
        "requestID",
        "challenge",
        "target",
        "consentVersion"
      ],
      "additionalProperties": false
    },
    "CreateResponse": {
      "type": "object",
      "properties": {
        "sessionID": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nonce": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxFrames": {
              "type": "number",
              "const": 25
            },
            "maxFrameBytes": {
              "type": "number",
              "const": 50000
            },
            "maxTotalBytes": {
              "type": "number",
              "const": 1250000
            },
            "maxDimension": {
              "type": "number",
              "const": 512
            },
            "framesPerRep": {
              "type": "number",
              "const": 5
            }
          },
          "required": [
            "maxFrames",
            "maxFrameBytes",
            "maxTotalBytes",
            "maxDimension",
            "framesPerRep"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sessionID",
        "nonce",
        "expiresAt",
        "limits"
      ],
      "additionalProperties": false
    },
    "SubmitRequest": {
      "type": "object",
      "properties": {
        "sessionID": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "nonce": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "evidenceID": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "consentVersion": {
          "type": "string",
          "const": "2026-10-11"
        },
        "frames": {
          "minItems": 1,
          "maxItems": 25,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,32}$"
              },
              "timestampMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 120000
              },
              "jpegBase64": {
                "type": "string",
                "minLength": 4,
                "maxLength": 66668
              }
            },
            "required": [
              "id",
              "timestampMs",
              "jpegBase64"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sessionID",
        "nonce",
        "evidenceID",
        "consentVersion",
        "frames"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "incomplete",
            "uncertain",
            "unavailable",
            "pending",
            "cancelled",
            "expired"
          ]
        },
        "reasonCode": {
          "type": "string"
        },
        "decisionID": {
          "type": "string"
        },
        "verifiedRepCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "cue": {
          "type": "string",
          "enum": [
            "none",
            "adjust_camera"
          ]
        }
      },
      "required": [
        "status",
        "reasonCode",
        "decisionID"
      ],
      "additionalProperties": false
    },
    "CancelRequest": {
      "type": "object",
      "properties": {
        "sessionID": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "sessionID"
      ],
      "additionalProperties": false
    },
    "CancelResponse": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "cancelled"
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  }
}
