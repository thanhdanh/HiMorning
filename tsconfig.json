{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "allowJs": true
  },
  "include": [
    "backend/functions/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "scripts/**/*.mjs"
  ]
}
