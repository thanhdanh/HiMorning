    <string name="challenge_guide_pushups">Bắt đầu với tay duỗi. Hạ người đến khi khuỷu tay gập khoảng 90°, rồi đẩy lên. Giữ vai, hông và cổ chân thẳng hàng.</string>
    <string name="challenge_guide_wave">Đưa lòng bàn tay và cổ tay vào khung hình. Vẫy tay sang một bên rồi đưa về. Một lượt đi và về tính một lần.</string>
    <string name="challenge_guide_neck">Nhìn thẳng vào camera. Quay sang trái rồi về giữa, sau đó quay sang phải rồi về giữa. Đủ cả hai bên mới tính một lần.</string>
    <string name="challenge_guide_jacks">Bắt đầu với hai chân khép, hai tay hạ. Bật tách chân và giơ cả hai tay, rồi trở về tư thế ban đầu. Đủ một vòng tính một lần.</string>
    <string name="challenge_guide_reach">Nâng cả hai khuỷu tay lên ngang vai và giữ một nhịp. Hạ cả hai tay trước khi giơ lần tiếp theo.</string>
    <string name="challenge_guide_seated">Ngồi đối diện camera. Bắt đầu với cổ tay thấp hơn vai, giơ cả hai tay lên qua vai rồi hạ xuống. Đủ một vòng tính một lần.</string>
    <string name="challenge_guide_standing">Đứng nghiêng người so với camera. Hơi khuỵu gối rồi đứng thẳng lại. Đủ một vòng tính một lần.</string>
    <string name="challenge_guide_words">App so các từ nhận diện được với đoạn tiếng Anh trên màn hình. Bạn đạt khi được ít nhất 80/100. Điểm chỉ phản ánh mức khớp từ.</string>
    <string name="challenge_guide_answer">Chọn đáp án đúng để hoàn thành. Nếu chọn sai, bạn có thể thử lại.</string>
    <string name="challenge_guide_camera">AI trên thiết bị nhận diện động tác và đếm số lần làm đúng.</string>
    <string name="challenge_guide_scoring_title">Cách app kiểm tra</string>
